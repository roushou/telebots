{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "plugins": ["react", "jsx-a11y", "import", "typescript", "unicorn"],
  "env": {
    "browser": true,
    "node": true
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "node_modules",
    ".output",
    ".tanstack",
    "dist",
    "build",
    "src/routeTree.gen.ts"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ]
}
