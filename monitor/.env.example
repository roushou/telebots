# See monitor/README.md for where each key comes from.
# Comma-separated name=url pairs; urls resolve on the compose network.
# Local dev: point at the bots' local metrics ports.
MONITOR_BOTS=degen=http://degen:9101/metrics,imagine=http://imagine:9102/metrics
# SQLite path; /data/monitor.db in the container (volume-mounted).
MONITOR_DB_PATH=/data/monitor.db
MONITOR_PORT=9110
# Optional: base URL the dashboard uses to reach this API (default http://127.0.0.1:9110).
# MONITOR_API_URL=http://127.0.0.1:9110
