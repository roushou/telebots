# Monitor alerts (optional — alerts are off when either value is unset).
# scripts/up.sh creates this file from the example on first run; fill it in
# on the VPS. See monitor/README.md for where each key comes from.

# Telegram bot token that sends alerts (from @BotFather, a separate bot from
# the monitored ones).
MONITOR_ALERT_TELEGRAM_TOKEN=

# Chat to send alerts to: a numeric chat id or a channel like @mychannel.
MONITOR_ALERT_CHAT_ID=
